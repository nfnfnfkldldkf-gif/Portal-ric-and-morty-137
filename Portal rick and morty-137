-- Shoot
local function shootPortal()
    if not character or not character.PrimaryPart then return end
    local hit = mouse.Hit
    if not hit then return end
    
    local ray = Ray.new(character.PrimaryPart.Position, (hit.Position - character.PrimaryPart.Position).Unit * 100)
    local part, hitPos, surfNorm = workspace:FindPartOnRayWithIgnoreList(ray, {character})
    
    if part and hitPos then
        PortalManager:createPortal(hitPos, surfNorm)
    end
end

tool.Activated:Connect(shootPortal)

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Q then
        shootPortal()
    end
end)

player.CharacterAdded:Connect(function(newChar)
    character = newChar
    wait(0.5)
    if not tool.Parent then
        tool.Parent = player.Backpack
    end
    wait(0.1)
    if player.Character then
        tool.Parent = player.Character
    end
end)

