-- Sounds
local function createSound(id)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. id
    sound.Volume = SETTINGS.SoundVolume
    sound.Parent = SoundService
    return sound
end

local portalOpenSound = createSound(9120392871)
local portalCloseSound = createSound(9120392872)
local teleportSound = createSound(9120392873)

-- Portal
local Portal = {}
Portal.__index = Portal

function Portal.new(position, normal)
    local self = setmetatable({}, Portal)
    
    self.model = Instance.new("Model")
    self.model.Name = "Portal"
    
    local disc = Instance.new("Part")
    disc.Name = "Disc"
    disc.Size = Vector3.new(SETTINGS.PortalSize, SETTINGS.PortalSize, 0.2)
    disc.Anchored = true
    disc.CanCollide = false
    disc.CanQuery = false
    disc.Material = Enum.Material.Neon
    disc.Color = SETTINGS.PortalColor
    disc.Transparency = 0.3
    disc.CFrame = CFrame.lookAt(position, position + normal)
    disc.Parent = self.model
    
    local ring = Instance.new("Part")
    ring.Name = "Ring"
    ring.Size = Vector3.new(SETTINGS.PortalSize + 1, SETTINGS.PortalSize + 1, 0.1)
    ring.Anchored = true
    ring.CanCollide = false
    ring.CanQuery = false
    ring.Material = Enum.Material.Neon
    ring.Color = SETTINGS.PortalColor
    ring.Transparency = 0.6
    ring.CFrame = disc.CFrame
    ring.Parent = self.model
    
    local particles = Instance.new("ParticleEmitter")
    particles.Name = "Swirl"
    particles.Texture = "rbxassetid://1234567890"
    particles.Color = ColorSequence.new(SETTINGS.PortalColor)
    particles.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 4)})
    particles.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1)})
    particles.VelocityInheritance = 0
    particles.SpreadAngle = Vector2.new(360, 360)
    particles.Lifetime = NumberRange.new(1, 2)
    particles.Rate = 50
    particles.RotSpeed = NumberRange.new(10, 30)
    particles.Speed = NumberRange.new(1, 3)
    particles.Parent = disc
    
    local light = Instance.new("PointLight")
    light.Name = "Light"
    light.Color = SETTINGS.PortalColor
    light.Range = 20
    light.Brightness = 2
    light.Parent = disc
    
    local teleportBox = Instance.new("Part")
    teleportBox.Name = "TeleportBox"
    teleportBox.Size = Vector3.new(SETTINGS.PortalSize, SETTINGS.PortalSize, 1)
    teleportBox.Anchored = true
    teleportBox.CanCollide = false
    teleportBox.CanQuery = false
    teleportBox.Transparency = 1
    teleportBox.CFrame = disc.CFrame
    teleportBox.Parent = self.model
    
    self.position = position
    self.normal = normal
    self.disc = disc
    self.teleportBox = teleportBox
    self.connectedPortal = nil
    self.lastTeleportTime = 0
    
    portalOpenSound:Play()
    
    disc.Size = Vector3.new(0.1, 0.1, 0.1)
    TweenService:Create(disc, TweenInfo.new(0.5, Enum.EasingStyle.Back), {
        Size = Vector3.new(SETTINGS.PortalSize, SETTINGS.PortalSize, 0.2)
    }):Play()
    
    TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Back), {
        Size = Vector3.new(SETTINGS.PortalSize + 1, SETTINGS.PortalSize + 1, 0.1)
    }):Play()
    
    self.model.Parent = workspace
    return self
end

function Portal:connect(otherPortal)
    self.connectedPortal = otherPortal
    otherPortal.connectedPortal = self
end

function Portal:teleport(character)
    if not self.connectedPortal then return false end
    if tick() - self.lastTeleportTime < 2 then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    local box = self.teleportBox
    local characterPos = character.PrimaryPart.Position
    local distance = (characterPos - box.Position).Magnitude
    
    if distance > SETTINGS.PortalSize / 2 then return false end
    
    local target = self.connectedPortal
    local targetPos = target.position + target.normal * 2
    
    teleportSound:Play()
    
    local tween = TweenService:Create(character.PrimaryPart, TweenInfo.new(0.3), {
        Position = targetPos
    })
    tween:Play()
    
    humanoid:MoveTo(targetPos)
    
    self.lastTeleportTime = tick()
    target.lastTeleportTime = tick()
    return true
end

function Portal:destroy()
    portalCloseSound:Play()
    TweenService:Create(self.disc, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
        Size = Vector3.new(0.1, 0.1, 0.1)
    }):Play()
    wait(0.3)
    self.model:Destroy()
end

-- Portal Manager
local PortalManager = {
    portals = {},
}

function PortalManager:createPortal(position, normal)
    while #self.portals >= SETTINGS.MaxPortals do
        local oldest = table.remove(self.portals, 1)
        oldest:destroy()
    end
    
    local portal = Portal.new(position, normal)
    table.insert(self.portals, portal)
    
    if #self.portals == 2 then
        self.portals[1]:connect(self.portals[2])
    end
    return portal
end

function PortalManager:clearPortals()
    for _, portal in ipairs(self.portals) do
        portal:destroy()
    end
    self.portals = {}
end

function PortalManager:update()
    for _, portal in ipairs(self.portals) do
        if portal.connectedPortal then
            for _, plr in ipairs(Players:GetPlayers()) do
                local char = plr.Character
                if char and char.PrimaryPart then
                    portal:teleport(char)
                end
            end
        end
    end
end

